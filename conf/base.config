process {
    cpus          = 1
    memory        = 4.GB
    time          = 4.h
    errorStrategy = { task.exitStatus in [104, 134, 137, 139, 140, 143] ? 'retry' : 'finish' }
    maxRetries    = 2

    withLabel: process_single { cpus = 1;                 memory = { 4.GB  * task.attempt }; time = { 2.h  * task.attempt } }
    withLabel: process_low    { cpus = { 2 * task.attempt }; memory = { 8.GB  * task.attempt }; time = { 4.h  * task.attempt } }
    withLabel: process_medium { cpus = { 6 * task.attempt }; memory = { 16.GB * task.attempt }; time = { 8.h  * task.attempt } }
    withLabel: process_high   { cpus = { 12 * task.attempt }; memory = { 32.GB * task.attempt }; time = { 16.h * task.attempt } }
    withLabel: process_download { cpus = 1; memory = 2.GB; time = 6.h; maxRetries = 3; errorStrategy = 'retry' }
}
