// Tool arguments (ext.args) and where each step publishes.
// Defaults reproduce the parameters chosen in the original D1–D4 benchmarks.

process {
    publishDir = [ path: { "${params.outdir}/${task.process.tokenize(':')[-1].toLowerCase()}" }, mode: 'copy' ]

    // ---- D1: read cleaning + assembly
    withName: 'FASTP' {
        ext.args   = '-f 10 -l 50 -r --cut_right_window_size 10 --cut_right_mean_quality 30'
        publishDir = [ path: { "${params.outdir}/01_assembly/fastp" }, mode: 'copy', pattern: '*.{json,html}' ]
    }
    withName: 'SPADES|SKESA' {
        ext.args   = ''
        publishDir = [ path: { "${params.outdir}/01_assembly/contigs" }, mode: 'copy', pattern: '*.contigs.fa' ]
    }
    withName: 'QUAST' {
        publishDir = [ path: { "${params.outdir}/01_assembly" }, mode: 'copy' ]
    }

    // ---- D2: gene prediction + functional annotation
    withName: 'PRODIGAL' {
        ext.args   = '-g 11 -p meta'
        publishDir = [ path: { "${params.outdir}/02_annotation/prodigal" }, mode: 'copy' ]
    }
    withName: 'EGGNOG_MAPPER' {
        ext.args   = '--itype proteins --override'
        publishDir = [ path: { "${params.outdir}/02_annotation/eggnog" }, mode: 'copy' ]
    }

    // ---- D3: typing, taxonomy, QC
    withName: 'MLST|BLAST_16S|SKANI|CHECKM|GUNC' {
        publishDir = [ path: { "${params.outdir}/03_characterization/${task.process.tokenize(':')[-1].toLowerCase()}" }, mode: 'copy' ]
    }
    withName: 'BARRNAP' {
        publishDir = [ path: { "${params.outdir}/03_characterization/barrnap" }, mode: 'copy' ]
    }

    // ---- D4: AMR, SNP phylogeny, clustering
    withName: 'AMRFINDER' {
        publishDir = [ path: { "${params.outdir}/04_comparative/amr" }, mode: 'copy' ]
    }
    withName: 'SNIPPY' {
        publishDir = [ path: { "${params.outdir}/04_comparative/snippy" }, mode: 'copy' ]
    }
    withName: 'SNIPPY_CORE|IQTREE|PARSNP|SNP_CLUSTERS' {
        ext.args   = ''
        publishDir = [ path: { "${params.outdir}/04_comparative/${task.process.tokenize(':')[-1].toLowerCase()}" }, mode: 'copy' ]
    }
    withName: 'IQTREE' {
        ext.args   = '-st DNA'
    }

    // ---- reference / database prep (cached, not published)
    withName: 'PREP_REFERENCE|DOWNLOAD_.*|AMRFINDER_UPDATE' {
        publishDir = [ enabled: false ]
    }

    // ---- reporting
    withName: 'MULTIQC|SUMMARY_REPORT' {
        publishDir = [ path: { "${params.outdir}" }, mode: 'copy' ]
    }
}
