manifest {
    name            = 'thangton/outbreakSurveillance'
    description     = 'Bacterial outbreak surveillance: reads -> assembly -> annotation -> characterization -> comparative genomics'
    mainScript      = 'main.nf'
    nextflowVersion = '!>=24.04.0'
    version         = '1.0.0'
}

params {
    // input: either a samplesheet (sample,fastq_1,fastq_2) or a read glob
    input              = null
    reads              = null
    outdir             = 'results'

    // D1 – assembly
    assembler          = 'spades'        // spades | skesa

    // D2 – annotation
    eggnog_db          = null            // path to eggNOG 5.0.2 data dir; eggNOG is skipped if unset

    // D3 – characterization
    taxon              = null            // genus for skani references; inferred from MLST if null
    checkm_species     = null            // CheckM taxonomy_wf species; inferred from skani if null
    skip_checkm        = false
    skip_gunc          = false

    // D4 – comparative genomics + AMR
    reference_gbk      = "${projectDir}/assets/reference/CP016016.gb"
    amrfinder_organism = 'Neisseria_gonorrhoeae'
    skip_comparative   = false

    // python helpers + downloaders (built from docker/Dockerfile)
    utils_container    = 'ghcr.io/thangton/outbreak-surveillance-utils:1.0.0'

    // downloaded databases are cached here and reused across runs
    db_cache           = "${launchDir}/databases"

    // resource ceiling
    max_cpus           = 16
    max_memory         = '64.GB'
    max_time           = '48.h'
}

includeConfig 'conf/base.config'
includeConfig 'conf/modules.config'

profiles {
    docker {
        docker.enabled      = true
        docker.runOptions   = '-u $(id -u):$(id -g)'
    }
    // Apple Silicon: biocontainers are amd64-only, run them under emulation
    arm {
        docker.runOptions   = '-u $(id -u):$(id -g) --platform=linux/amd64'
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
    }
    apptainer {
        apptainer.enabled    = true
        apptainer.autoMounts = true
    }
    pace    { includeConfig 'conf/pace.config' }
    // laptop-sized limits
    local   { params.max_cpus = 8; params.max_memory = '16.GB' }
}

process.resourceLimits = [
    cpus  : params.max_cpus as int,
    memory: params.max_memory as nextflow.util.MemoryUnit,
    time  : params.max_time as nextflow.util.Duration
]

def trace_ts = new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')
timeline { enabled = true; file = "${params.outdir}/pipeline_info/timeline_${trace_ts}.html" }
report   { enabled = true; file = "${params.outdir}/pipeline_info/report_${trace_ts}.html" }
trace    { enabled = true; file = "${params.outdir}/pipeline_info/trace_${trace_ts}.tsv" }
dag      { enabled = true; file = "${params.outdir}/pipeline_info/dag_${trace_ts}.html" }
